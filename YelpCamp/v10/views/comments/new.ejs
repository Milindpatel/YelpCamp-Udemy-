<%- include('../partials/header') %>
<div class="container col-md-6">
    <h1 class="text-center h3">Add New Comment to <%= campground.name %></h1>
    <form action="/campgrounds/<%= campground._id %>/comments" method="POST">
        <div class="mb-3">
            <label class="form-label" for="text">Comment</label>
            <textarea class="form-control" id="text" name="comment[text]" rows="3" required maxlength="2000"></textarea>
        </div>
        <button class="btn btn-lg btn-primary w-100">Submit!</button>
    </form>
    <a href="/campgrounds/<%= campground._id %>">Go Back</a>
</div>
<%- include('../partials/footer') %>

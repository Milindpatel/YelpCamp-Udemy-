<%- include('../partials/header') %>
<div class="container col-md-6">
    <h1 class="text-center h3">Edit Comment</h1>
    <form action="/campgrounds/<%= campground_id %>/comments/<%= comment._id %>?_method=PUT" method="POST">
        <div class="mb-3">
            <label class="form-label" for="text">Comment</label>
            <textarea class="form-control" id="text" name="comment[text]" rows="3" required maxlength="2000"><%= comment.text %></textarea>
        </div>
        <button class="btn btn-lg btn-primary w-100">Submit!</button>
    </form>
    <a href="/campgrounds/<%= campground_id %>">Go Back</a>
</div>
<%- include('../partials/footer') %>

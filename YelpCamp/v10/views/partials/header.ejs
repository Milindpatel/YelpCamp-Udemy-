<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>YelpCamp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/main.css">
</head>
<body>
<nav class="navbar navbar-expand bg-body-tertiary mb-3">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">YelpCamp</a>
        <ul class="navbar-nav ms-auto">
            <% if (!currentUser) { %>
                <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
                <li class="nav-item"><a class="nav-link" href="/register">Sign Up</a></li>
            <% } else { %>
                <li class="nav-item"><span class="nav-link">Signed in as <%= currentUser.username %></span></li>
                <li class="nav-item">
                    <form action="/logout" method="POST"><button class="btn btn-link nav-link">Logout</button></form>
                </li>
            <% } %>
        </ul>
    </div>
</nav>
<div class="container">
    <% if (error && error.length > 0) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success" role="status"><%= success %></div>
    <% } %>
</div>

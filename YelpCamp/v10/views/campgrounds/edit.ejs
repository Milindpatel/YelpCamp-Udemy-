<%- include('../partials/header') %>
<div class="container col-md-6">
    <h1 class="text-center">Edit <%= campground.name %></h1>
    <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST">
        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <input class="form-control" id="name" type="text" name="campground[name]" value="<%= campground.name %>" required maxlength="100">
        </div>
        <div class="mb-3">
            <label class="form-label" for="image">Image URL</label>
            <input class="form-control" id="image" type="url" name="campground[image]" value="<%= campground.image %>">
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="campground[description]" rows="4"><%= campground.description %></textarea>
        </div>
        <button class="btn btn-lg btn-primary w-100">Submit!</button>
    </form>
    <a href="/campgrounds/<%= campground._id %>">Go Back</a>
</div>
<%- include('../partials/footer') %>

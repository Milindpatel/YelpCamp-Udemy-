<%- include('../partials/header') %>
<div class="container col-md-6">
    <h1 class="text-center">Create a New Campground</h1>
    <form action="/campgrounds" method="POST">
        <div class="mb-3">
            <label class="form-label" for="name">Name</label>
            <input class="form-control" id="name" type="text" name="campground[name]" required maxlength="100">
        </div>
        <div class="mb-3">
            <label class="form-label" for="image">Image URL</label>
            <input class="form-control" id="image" type="url" name="campground[image]" placeholder="https://...">
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="campground[description]" rows="4"></textarea>
        </div>
        <button class="btn btn-lg btn-primary w-100">Submit!</button>
    </form>
    <a href="/campgrounds">Go Back</a>
</div>
<%- include('../partials/footer') %>

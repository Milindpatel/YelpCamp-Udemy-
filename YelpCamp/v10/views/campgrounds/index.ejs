<%- include('../partials/header') %>
<div class="container">
    <header class="p-4 mb-4 bg-body-tertiary rounded-3">
        <h1>Welcome To YelpCamp!</h1>
        <p class="lead">View our hand-picked campgrounds from all over the world!</p>
        <a class="btn btn-primary" href="/campgrounds/new">Add New Campground</a>
    </header>
    <div class="row g-3">
        <% campgrounds.forEach(function (campground) { %>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 text-center">
                    <% if (campground.image) { %>
                        <img class="card-img-top" src="<%= campground.image %>" alt="<%= campground.name %>">
                    <% } %>
                    <div class="card-body">
                        <h2 class="h5 card-title"><%= campground.name %></h2>
                        <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">More Info</a>
                    </div>
                </div>
            </div>
        <% }) %>
        <% if (campgrounds.length === 0) { %>
            <p class="text-muted">No campgrounds yet. Be the first to add one!</p>
        <% } %>
    </div>
</div>
<%- include('../partials/footer') %>
